# Variables du projet Vercel (Settings › Environment Variables), pour Production ET Preview.
# Jamais de valeur réelle dans ce fichier : il est public.

# API de la plateforme Vibe.IA (ex. https://app.vibe-ia.fr/api/v1)
VIBEIA_API_URL=
# Clé du site (vk_live_…), affichée sur la fiche du client dans la console Vibe.IA. Secrète : serveur uniquement.
VIBEIA_SITE_KEY=
# Adresse publique du site, sans « / » final
SITE_URL=https://mco-facilities.vibeia.io
